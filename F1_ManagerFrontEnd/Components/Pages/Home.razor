@page "/Home"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserStateService UserState

<PageTitle>YOU ARE LOGGED IN</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1>Welcome to F1 Manager @UserState.Username</h1>
        <button class="btn btn-secondary" @onclick="GoToRaceweekend">ga naar volgend raceweekend</button>
    </div>

    @if (_track != null)
    {
        <div class="card px-3 py-2 shadow-sm" style="min-width:180px;">
            <div class="fw-bold fs-6">@_track.NaamTrack</div>
            <div class="text-muted small">@_track.LandTrack</div>
            <div class="badge bg-secondary mt-1">@_track.LapsTrack ronden</div>
        </div>
    }
</div>

<div class="d-flex flex-wrap gap-3 mt-3">
    @if (_standings != null)
    {
        <div class="card shadow-sm p-3" style="min-width:300px; max-width:350px;">
            <h6 class="mb-3">Driver Standings</h6>
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Naam</th>
                        <th>Team</th>
                        <th>Punten per race</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (driver, index) in _standings.Select((d, i) => (d, i + 1)))
                    {
                        <tr class="@(driver.Team == _userTeamName ? "table-success" : "")">
                            <td>@index</td>
                            <td>@driver.Naam</td>
                            <td>@driver.Team</td>
                            <td>@driver.Punten</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<DriverStanding>? _standings;
    private string _userTeamName = "";
    private TrackInfo? _track;

    protected override async Task OnInitializedAsync()
    {
        var teamResponse = await Http.GetAsync($"get/Team/from/userID?IDUser={UserState.UserId}");
        if (teamResponse.IsSuccessStatusCode)
        {
            var teamId = await teamResponse.Content.ReadFromJsonAsync<int>();
            var allTeamsResponse = await Http.GetAsync("get/all/teams");
            if (allTeamsResponse.IsSuccessStatusCode)
            {
                var teams = await allTeamsResponse.Content.ReadFromJsonAsync<List<TeamData>>();
                _userTeamName = teams?.FirstOrDefault(t => t.IDTeam == teamId)?.NaamTeam ?? "";
            }
        }

        var standingsResponse = await Http.GetAsync($"get/driver/standings?IDUser={UserState.UserId}");
        if (standingsResponse.IsSuccessStatusCode)
        {
            _standings = await standingsResponse.Content.ReadFromJsonAsync<List<DriverStanding>>();
        }

        var trackResponse = await Http.GetAsync($"get/track/by/user?IDUser={UserState.UserId}");
        if (trackResponse.IsSuccessStatusCode)
        {
            _track = await trackResponse.Content.ReadFromJsonAsync<TrackInfo>();
        }
    }

    private void GoToRaceweekend() => Navigation.NavigateTo("/ResultRaceweekend");

    public class DriverStanding
    {
        public int DriverId { get; set; }
        public string Naam { get; set; } = "";
        public string Team { get; set; } = "";
        public int Punten { get; set; }
    }

    public class TeamData
    {
        public int IDTeam { get; set; }
        public string NaamTeam { get; set; } = "";
    }

    public class TrackInfo
    {
        public string NaamTrack { get; set; } = "";
        public string LandTrack { get; set; } = "";
        public int LapsTrack { get; set; }
    }
}