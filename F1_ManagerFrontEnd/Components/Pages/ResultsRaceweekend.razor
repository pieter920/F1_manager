@page "/ResultRaceweekend"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserStateService UserState

<div class="d-flex justify-content-between align-items-start mb-3">
    <h3>Race Resultaten</h3>

    @if (_track != null)
    {
        <div class="card text-end px-3 py-2 shadow-sm" style="min-width:180px;">
            <div class="fw-bold fs-6">🏁 @_track.NaamTrack</div>
            <div class="text-muted small">@_track.LandTrack</div>
            <div class="badge bg-secondary mt-1">@_track.LapsTrack ronden</div>
        </div>
    }
</div>
@if (_results == null)
{
    <button class="btn btn-primary mb-3" @onclick="SimulateRace">Simuleren</button>
}
else
{
    <button class="btn btn-secondary mb-3" @onclick="GoHome">Go Home</button>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Positie</th>
                <th>Naam</th>
                <th>Punten</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in _results)
            {
                <tr class="@(result.Team == _userTeamId ? "table-success" : "")">
                    <td>@result.Position</td>
                    <td>@result.Name</td>
                    <td>@result.Punten</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<RaceResult>? _results;
    private int _userTeamId;
    private TrackInfo? _track;
    protected override async Task OnInitializedAsync()
    {
        var trackResponse = await Http.GetAsync($"get/track/by/user?IDUser={UserState.UserId}");
        if (trackResponse.IsSuccessStatusCode)
        {
            _track = await trackResponse.Content.ReadFromJsonAsync<TrackInfo>();
        }
    }
    private async Task SimulateRace()
    {
        var url = $"simulate/raceweekend?IDUser={UserState.UserId}";
        var response = await Http.GetAsync(url);

        if (response.IsSuccessStatusCode)
        {
            _results = await response.Content.ReadFromJsonAsync<List<RaceResult>>();
        }
        else
        {
            Console.WriteLine($"Error: {response.StatusCode}");
        }
    }
    private void GoHome()
    {
        Navigation.NavigateTo("/Home");
    }
    public class TrackInfo
    {
        public string NaamTrack { get; set; } = "";
        public string LandTrack { get; set; } = "";
        public int LapsTrack { get; set; }
    }
    public class RaceResult
    {
        public int Position { get; set; }
        public int DriverId { get; set; }
        public string Name { get; set; } = "";
        public int Team { get; set; }
        public int Punten { get; set; }
    }
}