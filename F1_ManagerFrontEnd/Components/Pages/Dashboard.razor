        font-weight: 800;
        color: white;
        position: relative;
    }

        .progress-circle::before {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: #111;
            z-index: 1;
        }

    .progress-circle {
        z-index: 2;
    }

        .progress-circle span {
            position: relative;
            z-index: 2;
        }

    .season-text {
        color: #a1a1a1;
        text-align: center;
    }
</style>