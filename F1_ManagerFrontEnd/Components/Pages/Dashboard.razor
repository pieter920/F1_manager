    }

    .topbar h1 {
        margin: 8px 0 0 0;
        font-size: 3rem;
        text-transform: uppercase;
    }

    .next-race-button {
        height: 56px;
        padding: 0 28px;
        border: none;
        border-radius: 16px;
        background: linear-gradient( 135deg, #ff2d2d, #b80000);
        color: white;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .next-race-button:hover {
            transform: translateY(-2px);
        }

    /* GRID */

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px;
    }

    /* CARDS */

    .dashboard-card {
        background: linear-gradient( to bottom, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 28px;
        padding: 30px;
        backdrop-filter: blur(12px);
    }

    .card-header {
        color: #8f8f8f;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 28px;
    }

    /* TEAM */

    .team-card {
        grid-column: span 6;
    }

    .team-name {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .team-country {
        color: #a1a1a1;
        margin-bottom: 40px;
    }

    .car-name {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .performance-wrapper {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .performance-bar {
        width: 100%;
        height: 14px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255,255,255,0.08);
    }

    .performance-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient( to right, #ff2d2d, #ff7a00);
    }

    .performance-value {
        color: #ff3b30;
        font-weight: 700;
    }

    /* NEXT RACE */

    .next-race-card {
        grid-column: span 6;
    }

    .track-name {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .track-country {
        color: #b1b1b1;
        margin-bottom: 40px;
    }

    .race-info {
        display: flex;
        gap: 50px;
    }

    .info-label {
        display: block;
        color: #8f8f8f;
        margin-bottom: 8px;
        text-transform: uppercase;
        font-size: 0.8rem;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: 700;
    }

    /* DRIVERS */

    .drivers-card {
        grid-column: span 8;
    }

    .driver-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px;
        border-radius: 18px;
        background: rgba(255,255,255,0.03);
        margin-bottom: 18px;
    }

    .driver-name {
        font-size: 1.1rem;
        font-weight: 700;
