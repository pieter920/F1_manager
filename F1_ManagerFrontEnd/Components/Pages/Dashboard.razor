@page "/dashboard"
@using F1_ManagerFrontEnd.Models
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject UserStateService UserState
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Dashboard - F1 Manager</PageTitle>

<div class="dashboard-page">

    <!-- TOPBAR -->

    <div class="topbar">

        <div>
            <span class="welcome-text">
                Welcome back
            </span>

            <h1>
                <div class="dropdown" @onclick:stopPropagation>
                    <a @onclick="ToggleDropdown" style="cursor:pointer;">
                        @* <span style="font-size:large">▼</span>  *@@UserState.Username
                    </a>
                    @if (_showDropdown)
                    {
                        <div style="display:block; background:#111111; padding:5px; z-index:1000;">
                            <a @onclick="Logout" style="cursor:pointer; display:block; padding:5px 10px; font-size:medium">Log out</a>
                        </div>
                    }
                </div>
                @* @UserState.Username *@
            </h1>
        </div>

        <button type="button" class="next-race-button" @onclick="GoToRaceweekend">
            Simulate
        </button>

    </div>

    <!-- GRID -->

    <div class="dashboard-grid">

        <!-- TEAM -->

        <div class="dashboard-card team-card">

            <div class="card-header">
                Team Overview
            </div>

            <div class="team-name">
                @team.Naam
            </div>

            <div class="team-country">
                @team.Nationaliteit
            </div>

            <div class="car-section">

                <div class="car-name">
                    @CarName
                </div>

                <div class="performance-wrapper">

                    <span>Car Performance</span>

                    <div class="performance-bar">
                        <div class="performance-fill"
                             style="width:@CarPerformance%">
                        </div>
                    </div>

                    <span class="performance-value">
                        @CarPerformance
                    </span>

                </div>

            </div>

        </div>

        <!-- NEXT RACE -->

        <div class="dashboard-card next-race-card">

            <div class="card-header">
                Next Race
            </div>

            <div class="track-name">
                @track.NaamTrack
            </div>

            <div class="track-country">
                @track.LandTrack
            </div>

            <div class="race-info">

                <div>
                    <span class="info-label">Laps</span>
                    <span class="info-value">@track.LapsTrack</span>
                </div>

                <div>
                    <span class="info-label">Date</span>
                    <span class="info-value">@track.Begindatum - @track.EindDatum</span>
                </div>

            </div>

        </div>

        <!-- DRIVERS -->

        <div class="dashboard-card drivers-card">

            <div class="card-header">
                Drivers
            </div>
            @if (Drivers.Count < 2)
            {
                <button @onclick="OpenCreateDriver">+ ADD NEW DRIVER</button>
            }
            @foreach (var driver in Drivers)
            {
                <div class="driver-row">

                    <div>

                        <div class="driver-name">
                            @driver.VoornaamDriver @driver.AchternaamDriver
                        </div>

                        <div class="driver-nationality">
                            @driver.NationaliteitDriver
                        </div>

                    </div>

                    <div class="driver-stats">

                        <div>
                            <span>RTG</span>
                            <strong>@driver.Rating</strong>
                        </div>

                        <div>
                            <span>CONF</span>
                            <strong>@driver.Confidence</strong>
                        </div>

                    </div>

                </div>
            }

        </div>

        <!-- SEASON  TODO: IMPLEMENT SOMETHING DECENT-->

        <div class="dashboard-card season-card"
             @onclick="GoToNextPage">

            <div class="card-header">
                Season Progress
            </div>

            <div class="season-progress">

                <div class="progress-circle"
                     style="background: conic-gradient(
                    #ff2d2d @(percentage.ToString(CultureInfo.InvariantCulture))%,
                    #2b2b2b 0);">

                    <span>@CompletedRaces/24</span>

                </div>

                <div class="season-text">
                    Race weekends completed
                </div>

            </div>

        </div>

    </div>

</div>

@code {
    TeamModel team = new();

    List<DriverModel> Drivers = new();
    Track track = new();

    private string CarName = "DS2025";

    private int CarPerformance = 78;

    //private string NextTrackName = "Albert Park";

    //private string NextTrackCountry = "Australia";

    //private int NextTrackLaps = 58;

    //private string NextRaceDate = "14 Mar - 16 Mar";

    private int CompletedRaces = 0;

    private int TotalRaces = 24;

    private double percentage =>(double)CompletedRaces / 24 * 100;



    protected override async Task OnInitializedAsync()
    {
        // TEMP STATIC DATA
        // Replace with API calls later
        await GetCurrentRaceCount();

        //get team
        await GetTeam();

        await GetNextRace();

        //get drivers 
        await GetDrivers();

        // Drivers = new()
