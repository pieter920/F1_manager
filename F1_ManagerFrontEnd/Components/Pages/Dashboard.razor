    }

    .driver-nationality {
        color: #9a9a9a;
    }

    .driver-stats {
        display: flex;
        gap: 28px;
    }

        .driver-stats div {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .driver-stats span {
            font-size: 0.7rem;
            color: #8f8f8f;
            margin-bottom: 4px;
        }

        .driver-stats strong {
