@page "/CreateDriver"
@using F1_ManagerFrontEnd.Models
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserStateService UserState

<PageTitle>Create Driver - F1 Manager</PageTitle>

<div class="create-driver-page">

    <div class="driver-card">

        <div class="form-section">

            <div class="form-header">

                <span class="page-label">
                    DRIVER ACADEMY
                </span>

                <h1>
                    Create Driver
                </h1>

                <p>
                    Sign a new talent to the team.
                </p>

            </div>

            <EditForm Model="@DriverModel">

                <div class="form-group">

                    <label>First Name</label>

                    <InputText @bind-Value="DriverModel.FirstName"
                               class="form-input"
                               placeholder="Mats" />

                </div>

                <div class="form-group">

                    <label>Last Name</label>

                    <InputText @bind-Value="DriverModel.LastName"
                               class="form-input"
                               placeholder="Van Het Einde" />

                </div>

                <div class="form-group">

                    <label>Nationality</label>

                    <InputSelect @bind-Value="DriverModel.Nationality"
                                 class="form-input">

                        <option value="">
                            Select nationality
                        </option>

                        <option value="Belgium">
                            Belgium
                        </option>

                        <option value="Netherlands">
                            Netherlands
                        </option>

                        <option value="United Kingdom">
                            United Kingdom
                        </option>

                        <option value="Germany">
                            Germany
                        </option>

                        <option value="France">
                            France
                        </option>

                    </InputSelect>

                </div>

                <div class="form-group">

                    <label>Age</label>

                    <InputNumber @bind-Value="DriverModel.Age"
                                 class="form-input" />

                </div>

                <button class="continue-button" @onclick="CreateNewDriver">
                    Continue
                </button>

            </EditForm>

        </div>

    </div>

</div>



<style>
    .create-driver-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background: linear-gradient( to bottom, #050505, #101010);
        color: white;
    }

    /* CARD */

    .driver-card {
        border-radius: 32px;
        background: linear-gradient( to bottom, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
        border: 1px solid rgba(255,255,255,0.06);
        backdrop-filter: blur(18px);
    }

    /* RIGHT */

    .form-section {
        padding: 60px;
    }

    .page-label {
        color: #ff3b30;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 3px;
    }

    .form-header h1 {
        margin: 20px 0 12px 0;
        font-size: 3.5rem;
        text-transform: uppercase;
    }

    .form-header p {
        color: #9a9a9a;
        margin-bottom: 50px;
    }

    /* FORM */

    .form-group {
        margin-bottom: 28px;
    }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            color: #d8d8d8;
            font-weight: 600;
        }
    /* INPUTS */

    .form-input {
        width: 100%;
        height: 62px;
        padding: 0 20px;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 18px;
        background: rgba(255,255,255,0.04);
        color: white;
        font-size: 1rem;
        font-weight: 500;
        outline: none;
        transition: all 0.2s ease;
        backdrop-filter: blur(10px);
    }

        .form-input::placeholder {
            color: #7f7f7f;
        }

        .form-input:hover {
            background: rgba(255,255,255,0.055);
            border-color: rgba(255,255,255,0.12);
        }

        .form-input:focus {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,59,48,0.65);
            box-shadow: 0 0 0 4px rgba(255,59,48,0.12);
        }

    /* SELECT */

    select.form-input {
        appearance: none;
        cursor: pointer;
    }

        select.form-input option {
            background: #111111;
            color: white;
        }

    /* NUMBER INPUT */

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        opacity: 0.4;
    }

    /* BUTTON */

    .continue-button {
        margin-top: 20px;
        width: 100%;
        height: 62px;
        border: none;
        border-radius: 18px;
        background: linear-gradient( 135deg, #ff2d2d, #b80000);
        color: white;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .continue-button:hover {
            transform: translateY(-2px);
        }
</style>
