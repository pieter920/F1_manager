@* @page "/create-driver" *@

<PageTitle>Create Driver - F1 Manager</PageTitle>

<div class="create-driver-page">

    <div class="driver-card">

        <!-- LEFT -->

@*         <div class="preview-section">

            <div class="driver-avatar">
                🏎️
            </div>

            <div class="driver-rating">
                67 OVR
            </div>

            <div class="driver-potential">
                Future Talent
            </div>

            <div class="driver-stats">

                <div class="stat-box">
                    <span>Confidence</span>
                    <strong>80</strong>
                </div>

                <div class="stat-box">
                    <span>Potential</span>
                    <strong>A</strong>
                </div>

            </div>

        </div> *@

        <!-- RIGHT -->

        <div class="form-section">

            <div class="form-header">

                <span class="page-label">
                    DRIVER ACADEMY
                </span>

                <h1>
                    Create Driver
                </h1>

                <p>
                    Sign a new talent to the team.
                </p>

            </div>

            <EditForm Model="@DriverModel">

                <div class="form-group">

                    <label>First Name</label>

                    <InputText @bind-Value="DriverModel.FirstName"
                               class="form-input"
                               placeholder="Mats" />

                </div>

                <div class="form-group">

                    <label>Last Name</label>

                    <InputText @bind-Value="DriverModel.LastName"
                               class="form-input"
                               placeholder="Van Het Einde" />

                </div>

                <div class="form-group">

                    <label>Nationality</label>

                    <InputSelect @bind-Value="DriverModel.Nationality"
                                 class="form-input">

                        <option value="">
                            Select nationality
                        </option>

                        <option value="Belgium">
                            Belgium
                        </option>

                        <option value="Netherlands">
                            Netherlands
                        </option>

                        <option value="United Kingdom">
                            United Kingdom
                        </option>

                        <option value="Germany">
                            Germany
                        </option>

                        <option value="France">
                            France
                        </option>

                    </InputSelect>

                </div>

                <div class="form-group">

                    <label>Age</label>

                    <InputNumber @bind-Value="DriverModel.Age"
                                 class="form-input" />

                </div>

                <button class="continue-button" @onclick="CreateNewDriver">
                    Continue
                </button>

            </EditForm>

        </div>

    </div>

</div>

@code {

    private DriverCreateModel DriverModel = new();

    public class DriverCreateModel
    {
        public string FirstName { get; set; } = "";

        public string LastName { get; set; } = "";

        public string Nationality { get; set; } = "";

        public int Age { get; set; } = 18;
    }

    Random rng = new Random();
    private int _rating = 0;

    public async Task CreateNewDriver()
    {
        //teamID opvragen van het team van de user
        // var urlTeamID = $"get/Team/from/userID?IDUser={UserState.UserId}";
        // var responseTeamID = await Http.GetAsync(urlTeamID);
        // var team = await responseTeamID.Content.ReadFromJsonAsync<TeamModel>();
        //generate random rating tussen 75 en 80
        _rating = rng.Next(75, 81);
        //driver aanmaken en deze koppelen aan het team van de user
        var urlDriverCreate = $"Create/Driver?VoorNaamDriver={Uri.EscapeDataString(DriverModel.FirstName)}&AchterNaamDriver={Uri.EscapeDataString(DriverModel.LastName)}&NationaliteitDriver={Uri.EscapeDataString(DriverModel.Nationality)}&Leeftijd={DriverModel.Age}&ratingDriver={_rating}&TeamID={UserState.TeamId}";
        var responseDriverCreate = await Http.PostAsync(urlDriverCreate, null);
        Navigation.NavigateTo("/dashboard");
    }
}

