@page "/login"
@inject HttpClient Http
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserStateService UserState


<PageTitle>Login - F1 Team Manager</PageTitle>

<div class="auth-page">
    <div class="background-overlay"></div>

    <div class="auth-container">

        <!-- LEFT SIDE -->
        <div class="branding-section">

            <a href="/" class="back-home">
                ← Back to Home
            </a>

            <div class="branding-content">
                <span class="season-label">F1 MANAGER ONLINE</span>

                <h1>
                    Welcome Back,<br />
                    Team Principal.
                </h1>

                <p>
                    Continue building your Formula 1 dynasty.
                    Your engineers, drivers, and fans are waiting.
                </p>

                <div class="feature-list">

                    <div class="feature-item">
                        <div class="feature-icon">🏎️</div>

                        <div>
                            <h3>Manage Your Team</h3>
                            <span>Control every aspect of your F1 organization.</span>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">📊</div>

                        <div>
                            <h3>Race Strategy</h3>
                            <span>Make live strategic decisions during race weekends.</span>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">🏆</div>

                        <div>
                            <h3>Fight For Glory</h3>
                            <span>Compete against managers worldwide.</span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT SIDE -->
        <div class="login-section">

            <div class="login-card">

                <div class="login-header">
                    <h2>Login</h2>
                    <p>Enter the paddock</p>
                </div>

                <EditForm Model="@loginModel" OnValidSubmit="LoginUser">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>Username</label>

                        <InputText @bind-Value="loginModel.UserName"
                                   class="form-input"
                                   placeholder="Pinochio" />
                    </div>

                    <div class="form-group">
                        <label>Password</label>

                        <InputText @bind-Value="loginModel.Password"
                                   type="password"
                                   class="form-input"
                                   placeholder="Enter your password" />
                    </div>

@*                     <div class="form-options">

                        <label class="remember-me">
                            <InputCheckbox @bind-Value="loginModel.RememberMe" />
                            <span>Remember me</span>
                        </label>

                        <a href="/forgot-password" class="forgot-password">
                            Forgot password?
                        </a>

                    </div> *@

                    <button type="submit" class="login-button">
                        Enter Garage
                    </button>

                </EditForm>

@*                 <div class="divider">
                    <span>OR</span>
                </div>

                <button class="discord-button">
                    <span>🎮</span>
                    Continue with Discord
                </button> *@

                <div class="register-link">
                    Don't have a team yet?
                    <a href="/register">Create Team</a>
                </div>

            </div>

        </div>

    </div>
</div>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #050505;
    }

    .auth-page {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
        background: linear-gradient(to right, rgba(0,0,0,0.92), rgba(0,0,0,0.75)), url('/images/login-background.jpg') center/cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }

    .background-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(255,0,0,0.12), transparent 30%);
    }

    .auth-container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1450px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        border-radius: 30px;
        overflow: hidden;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        backdrop-filter: blur(16px);
        box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    }

    /* LEFT */

    .branding-section {
        padding: 60px;
        position: relative;
    }

    .back-home {
        color: #c9c9c9;
        text-decoration: none;
        font-size: 0.95rem;
        transition: 0.2s ease;
    }

        .back-home:hover {
            color: white;
        }

    .branding-content {
        margin-top: 80px;
    }

    .season-label {
        display: inline-block;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.08);
        padding: 10px 18px;
        border-radius: 999px;
        color: #ff3b30;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .branding-content h1 {
        color: white;
        font-size: 4rem;
        line-height: 1;
        margin-top: 30px;
        margin-bottom: 25px;
        text-transform: uppercase;
    }

    .branding-content p {
        color: #c6c6c6;
        font-size: 1.1rem;
        line-height: 1.8;
        max-width: 550px;
    }

    .feature-list {
        margin-top: 60px;
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 20px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 18px;
        padding: 20px;
    }

    .feature-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #ff2d2d, #990000);
        font-size: 1.4rem;
    }

    .feature-item h3 {
        color: white;
        margin: 0 0 5px 0;
    }

    .feature-item span {
        color: #c7c7c7;
        font-size: 0.95rem;
    }

    /* RIGHT */

    .login-section {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px;
        background: linear-gradient(to bottom, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    }

    .login-card {
        width: 100%;
        max-width: 430px;
    }

    .login-header {
        margin-bottom: 40px;
    }

        .login-header h2 {
            color: white;
            font-size: 2.5rem;
            margin-bottom: 8px;
        }

        .login-header p {
            color: #bdbdbd;
            margin: 0;
        }

    .form-group {
        margin-bottom: 24px;
    }

        .form-group label {
            display: block;
            color: #e3e3e3;
            margin-bottom: 10px;
            font-size: 0.95rem;
            font-weight: 600;
        }

    .form-input {
        width: 100%;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.05);
        color: white;
        font-size: 1rem;
        outline: none;
        transition: 0.25s ease;
    }

        .form-input:focus {
            border-color: rgba(255,0,0,0.8);
            box-shadow: 0 0 0 4px rgba(255,0,0,0.15);
        }

    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #c9c9c9;
        font-size: 0.95rem;
    }

    .forgot-password {
        color: #ff4b4b;
        text-decoration: none;
        font-size: 0.95rem;
    }

        .forgot-password:hover {
            text-decoration: underline;
        }

    .login-button {
        width: 100%;
        padding: 18px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(135deg, #ff2d2d, #b80000);
        color: white;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.25s ease;
        box-shadow: 0 12px 28px rgba(255,0,0,0.3);
    }

        .login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(255,0,0,0.4);
        }

    .divider {
        position: relative;
        text-align: center;
        margin: 35px 0;
    }

        .divider::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: rgba(255,255,255,0.08);
        }

        .divider span {
            position: relative;
            padding: 0 18px;
            background: #111;
            color: #999;
            font-size: 0.9rem;
        }

    .discord-button {
        width: 100%;
        padding: 16px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.05);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .discord-button:hover {
            background: rgba(255,255,255,0.09);
        }

    .register-link {
        margin-top: 30px;
        text-align: center;
        color: #c4c4c4;
    }

        .register-link a {
            color: #ff3b30;
            text-decoration: none;
            font-weight: 700;
        }

            .register-link a:hover {
                text-decoration: underline;
            }

    @@media(max-width: 1100px) {

        .auth-container {
            grid-template-columns: 1fr;
        }

        .branding-section {
            display: none;
        }
    }

    @@media(max-width: 768px) {

        .auth-page {
            padding: 15px;
        }

        .login-section {
            padding: 30px 20px;
        }

        .login-header h2 {
            font-size: 2rem;
        }
    }

</style>